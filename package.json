{
  "devDependencies": {
    "vitepress": "^2.0.0-alpha.15",
    "vue": "^3.5.25"
  },
  "scripts": {
    "affiliate:validate": "node scripts/validate-affiliate-links.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "npm run affiliate:validate && npm run recipes:check && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "recipes:check": "node scripts/recipes/generate-all.mjs --check",
    "recipes:generate": "node scripts/recipes/generate-all.mjs",
    "recipes:validate": "node scripts/recipes/validate-recipes.mjs",
    "test:affiliate": "node --test scripts/affiliate-links.test.mjs",
    "test:recipes": "node --test scripts/recipes/recipe-pipeline.test.mjs"
  }
}
